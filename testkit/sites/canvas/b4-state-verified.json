{
  "protocol_version": "0.1",
  "kind": "workflow",
  "goal": "点击后界面外观不变，只能靠页面状态判断操作是否成功",
  "policy": {
    "max_wall_ms": 20000,
    "max_model_calls": 2,
    "allowed_hosts": ["127.0.0.1"]
  },
  "steps": [
    {
      "id": "s1",
      "goal": "打开有 300ms 服务端确认的画布页面",
      "actions": [{ "type": "navigate", "url": "http://127.0.0.1:8766/canvas/?mode=canvas&layout=a&slow=1" }],
      "timeout_ms": 8000
    },
    {
      "id": "s2",
      "goal": "点击红色按钮，等服务端确认后由状态判定成功",
      "actions": [
        { "type": "click", "target": { "visual": "the red button" } }
      ],
      "success": { "type": "js", "script": "window.__canvasState().confirmed === true" },
      "timeout_ms": 8000
    }
  ]
}
