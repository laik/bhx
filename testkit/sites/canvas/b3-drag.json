{
  "protocol_version": "0.1",
  "kind": "workflow",
  "goal": "把蓝色圆点拖到绿色放置区域，起点和落点都要准确",
  "policy": {
    "max_wall_ms": 20000,
    "max_model_calls": 2,
    "allowed_hosts": ["127.0.0.1"]
  },
  "steps": [
    {
      "id": "s1",
      "goal": "打开拖拽画布",
      "actions": [{ "type": "navigate", "url": "http://127.0.0.1:8766/canvas/?mode=drag" }],
      "timeout_ms": 8000
    },
    {
      "id": "s2",
      "goal": "从截图定位蓝色圆点与绿色区域并拖拽",
      "actions": [
        {
          "type": "drag",
          "from": { "visual": "the blue knob" },
          "to": { "visual": "the green drop zone" },
          "steps": 12
        }
      ],
      "success": {
        "type": "js",
        "script": "window.__canvasState().drags.length >= 1 && window.__canvasState().drags[0].ok"
      },
      "timeout_ms": 8000
    }
  ]
}
